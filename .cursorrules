### Configuration Management

#### Core Configuration
```python
# ai/core/config.py
from functools import lru_cache
from typing import List, Optional

from pydantic import BaseSettings, Field, validator


class Settings(BaseSettings):
    """Application settings with environment variable support."""
    
    # Application
    app_name: str = "TransparentSF"
    debug: bool = Field(False, env="DEBUG")
    log_level: str = Field("INFO", env="LOG_LEVEL")
    
    # Database
    postgres_url: str = Field(..., env="POSTGRES_URL")
    redis_url: str = Field("redis://localhost:6379", env="REDIS_URL")
    
    # API Keys
    openai_api_key: str = Field(..., env="OPENAI_API_KEY")
    
    # Data Processing
    max_dataframe_size_mb: int = Field(100, env="MAX_DATAFRAME_SIZE_MB")
    anomaly_detection_threshold: float = Field(2.0, env="ANOMALY_THRESHOLD")
    
    # CORS
    allowed_origins: List[str] = Field(
        default=["http://localhost:8081"],
        env="ALLOWED_ORIGINS"
    )
    
    @validator("log_level")
    def validate_log_level(cls, v):
        """Validate log level is supported."""
        valid_levels = ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        if v.upper() not in valid_levels:
            raise ValueError(f"Log level must be one of: {valid_levels}")
        return v.upper()
    
    class Config:
        env_file = ".env"
        case_sensitive = False


@lru_cache()
def get_settings() -> Settings:
    """Get cached application settings."""
    return Settings()


# Usage
settings = get_settings()
```

## API Design Patterns

### FastAPI Route Structure
```python
# ai/api/routes/analytics.py
from fastapi import APIRouter, Depends, HTTPException, status
from fastapi.responses import JSONResponse

from ...core.config import get_settings
from ...core.exceptions import ValidationError
from ...models.api import AnalysisRequest, AnalysisResponse
from ...services.analytics_service import AnalyticsService
from ..dependencies import get_analytics_service, get_session_manager

router = APIRouter(prefix="/api/analytics", tags=["analytics"])


@router.post(
    "/analyze",
    response_model=AnalysisResponse,
    status_code=status.HTTP_201_CREATED,
    summary="Perform data analysis",
    description="Analyze SF public datasets for trends and anomalies"
)
async def create_analysis(
    request: AnalysisRequest,
    analytics_service: AnalyticsService = Depends(get_analytics_service),
    session_manager = Depends(get_session_manager)
) -> AnalysisResponse:
    """Create new data analysis."""
    try:
        result = await analytics_service.analyze(
            dataset=request.dataset,
            parameters=request.parameters,
            session_id=session_manager.session_id
        )
        return AnalysisResponse(
            analysis_id=result.id,
            status="completed",
            results=result.data
        )
    except ValidationError as e:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail={"error": "validation_failed", "message": str(e)}
        )
    except Exception as e:
        logger.exception("Analysis creation failed")
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail={"error": "internal_error", "message": "Analysis failed"}
        )
```

### Pydantic Models
```python
# ai/models/api.py
from datetime import datetime
from typing import Any, Dict, List, Optional

from pydantic import BaseModel, Field, validator


class BaseAPIModel(BaseModel):
    """Base model for API requests/responses."""
    
    class Config:
        extra = "forbid"  # Reject unknown fields
        validate_assignment = True


class AnalysisRequest(BaseAPIModel):
    """Request model for analysis creation."""
    
    dataset: str = Field(..., description="Dataset identifier", min_length=1)
    parameters: Dict[str, Any] = Field(default_factory=dict)
    district: Optional[int] = Field(None, ge=0, le=11, description="SF District")
    date_range: Optional[Dict[str, str]] = Field(None)
    
    @validator("dataset")
    def validate_dataset(cls, v):
        """Validate dataset identifier."""
        allowed_datasets = [
            "police_incidents", "fire_incidents", "building_permits", 
            "311_calls", "budget_data"
        ]
        if v not in allowed_datasets:
            raise ValueError(f"Dataset must be one of: {allowed_datasets}")
        return v


class AnalysisResponse(BaseAPIModel):
    """Response model for analysis results."""
    
    analysis_id: str = Field(..., description="Unique analysis identifier")
    status: str = Field(..., description="Analysis status")
    created_at: datetime = Field(default_factory=datetime.utcnow)
    results: Optional[Dict[str, Any]] = Field(None)
    error_message: Optional[str] = Field(None)
```

## AI Agents Pattern

### Base Agent Interface
```python
# ai/agents/base.py
from abc import ABC, abstractmethod
from typing import Any, Dict, List

from ..core.logging import get_logger
from ..models.session import SessionContext

logger = get_logger(__name__)


class BaseAgent(ABC):
    """Abstract base class for all AI agents."""
    
    def __init__(self, name: str, tools: List[str] = None) -> None:
        """Initialize agent with name and available tools."""
        self.name = name
        self.tools = tools or []
        logger.info(f"Initialized {self.__class__.__name__} agent: {name}")
    
    @abstractmethod
    async def process_message(
        self, 
        message: Dict[str, Any], 
        context: SessionContext
    ) -> Dict[str, Any]:
        """
        Process incoming message and return response.
        
        Args:
            message: User message with content and metadata
            context: Session context with history and state
            
        Returns:
            Agent response with content and actions
        """
        pass
    
    @abstractmethod
    def get_available_tools(self) -> List[str]:
        """Get list of tools available to this agent."""
        pass
    
    async def validate_input(self, message: Dict[str, Any]) -> bool:
        """Validate input message format."""
        required_fields = ["content", "user_id", "timestamp"]
        return all(field in message for field in required_fields)
```

### Tool Registry Pattern
```python
# ai/tools/registry.py
from typing import Dict, Type

from .base import BaseTool


class ToolRegistry:
    """Registry for discovering and managing tools."""
    
    def __init__(self) -> None:
        self._tools: Dict[str, Type[BaseTool]] = {}
    
    def register(self, tool_class: Type[BaseTool]) -> None:
        """Register a tool class."""
        self._tools[tool_class.name] = tool_class
    
    def get_tool(self, name: str) -> Type[BaseTool]:
        """Get tool class by name."""
        if name not in self._tools:
            raise ValueError(f"Tool '{name}' not registered")
        return self._tools[name]
    
    def list_tools(self) -> List[str]:
        """List all registered tool names."""
        return list(self._tools.keys())


# Global registry instance
tool_registry = ToolRegistry()


# Decorator for auto-registration
def register_tool(tool_class: Type[BaseTool]) -> Type[BaseTool]:
    """Decorator to auto-register tools."""
    tool_registry.register(tool_class)
    return tool_class
```

## Testing Standards

### Test Structure
```python
# tests/test_services/test_anomaly_service.py
import pytest
import pandas as pd
from unittest.mock import AsyncMock, patch

from ai.services.anomaly_service import AnomalyService
from ai.core.exceptions import AnomalyDetectionError
from ai.models.data import TimeSeriesData


class TestAnomalyService:
    """Test suite for AnomalyService."""
    
    @pytest.fixture
    def sample_data(self) -> pd.DataFrame:
        """Create sample time series data for testing."""
        return pd.DataFrame({
            'timestamp': pd.date_range('2024-01-01', periods=100, freq='D'),
            'value': range(100)
        })
    
    @pytest.fixture
    def anomaly_service(self) -> AnomalyService:
        """Create AnomalyService instance for testing."""
        return AnomalyService(threshold=2.0)
    
    @pytest.mark.asyncio
    async def test_detect_anomalies_success(
        self, 
        anomaly_service: AnomalyService,
        sample_data: pd.DataFrame
    ):
        """Test successful anomaly detection."""
        # Arrange
        data = TimeSeriesData(data=sample_data)
        
        # Act
        results = await anomaly_service.detect_anomalies(data)
        
        # Assert
        assert isinstance(results, list)
        assert len(results) == len(sample_data)
        assert all(hasattr(r, 'is_anomaly') for r in results)
    
    @pytest.mark.asyncio
    async def test_detect_anomalies_invalid_method(
        self,
        anomaly_service: AnomalyService,
        sample_data: pd.DataFrame
    ):
        """Test anomaly detection with invalid method."""
        # Arrange
        data = TimeSeriesData(data=sample_data)
        
        # Act & Assert
        with pytest.raises(AnomalyDetectionError):
            await anomaly_service.detect_anomalies(data, method="invalid")
```

