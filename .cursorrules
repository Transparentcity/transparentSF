    data: pd.DataFrame, 
    method: str = "zscore",
    threshold: float = 2.0
) -> Tuple[pd.Series, Dict[str, Any]]:
    """
    Calculate anomaly scores for time series data.
    
    Uses statistical methods to identify data points that deviate
    significantly from expected patterns.
    
    Args:
        data: Input DataFrame with time series data
        method: Statistical method to use ('zscore', 'iqr', 'isolation_forest')
        threshold: Threshold for anomaly classification
        
    Returns:
        Tuple containing:
        - Series of boolean anomaly flags
        - Dictionary with detection metadata
        
    Raises:
        ValidationError: If data format is invalid
        AnomalyDetectionError: If calculation fails
        
    Example:
        >>> df = pd.DataFrame({'value': [1, 2, 100, 3, 4]})
        >>> anomalies, metadata = calculate_anomaly_score(df)
        >>> print(anomalies.sum())  # Number of anomalies detected
        1
    """
