# Google Cloud Storage Configuration
# Copy this file to .env and fill in your values

# Google Cloud Project ID
GCP_PROJECT_ID=your-project-id

# Google Cloud Storage Bucket Name
GCS_BUCKET_NAME=your-bucket-name

# Google Cloud Authentication
# Option 1: Service Account Key File (recommended for production)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Use default credentials (for development)
# Uncomment the line below if you want to use default credentials
# GOOGLE_APPLICATION_CREDENTIALS=

# Storage Configuration
# Set to 'true' to enable GCS, 'false' to use local storage only
ENABLE_GCS=true

# Local fallback directory (relative to ai/ directory)
LOCAL_OUTPUT_DIR=output

# Logging Configuration
LOG_LEVEL=INFO

# GCS Logging Configuration
# Enable GCS logging for sessions and evaluations
ENABLE_GCS_LOGGING=true

# Log retention settings (in days)
# How long to keep logs in local storage before cleanup
LOG_RETENTION_DAYS=30

# GCS log organization
# Logs will be organized by year/month in GCS bucket
# Structure: logs/sessions/YYYY/MM/session_id.json
# Structure: logs/evals/YYYY/MM/eval_id.json
